@{
    ViewData["Title"] = "Home";
}

<div class="py-5 text-center">
    <h1 class="display-5 fw-bold">Real-Time Processing App</h1>
    <p class="lead">Azure App Service, Event Hubs, Azure Functions and Azure SQL.</p>
    <p class="text-muted">Use this project as the practicum base. Replace the Azure settings with the resources required by the exam paper.</p>

    <div class="mt-4">
        <a asp-controller="Orders" asp-action="Index" class="btn btn-primary me-2">Send Order Event</a>
        <a asp-controller="ProcessedOrders" asp-action="Index" class="btn btn-outline-dark me-2">View Processed Data</a>
        <a asp-action="Architecture" class="btn btn-outline-secondary">View Architecture</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h5>1. App Service</h5><p class="mb-0">Hosts the MVC web application.</p></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h5>2. Event Hubs</h5><p class="mb-0">Receives real-time order events.</p></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h5>3. Functions</h5><p class="mb-0">Processes and classifies events.</p></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><h5>4. Azure SQL</h5><p class="mb-0">Stores processed results for querying.</p></div></div></div>
</div>
