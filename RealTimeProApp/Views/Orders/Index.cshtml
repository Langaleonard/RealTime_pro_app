@model OrderEvent
@{
    ViewData["Title"] = "Send Order Event";
}

<h1>Send Order Event</h1>
<p class="text-muted">Publish a test order to Azure Event Hubs.</p>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning">@TempData["ErrorMessage"]</div>
}
@if (ViewBag.EventHubConfigured == false)
{
    <div class="alert alert-info">Event Hubs is not configured yet. See README_EXAM_SETUP.txt before testing this page.</div>
}

<div class="row">
    <div class="col-lg-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="OrderId" class="form-label"></label>
                <input asp-for="OrderId" class="form-control" />
                <span asp-validation-for="OrderId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" step="0.01" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">Publish Event</button>
        </form>
    </div>
</div>
