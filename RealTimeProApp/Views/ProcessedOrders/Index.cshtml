@model IEnumerable<ProcessedOrder>
@{
    ViewData["Title"] = "Processed Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Processed Orders</h1>
        <p class="text-muted mb-0">Recent records stored in Azure SQL Database.</p>
    </div>
    <a class="btn btn-outline-dark" asp-action="Index">Refresh</a>
</div>

@if (ViewBag.SqlConfigured == false)
{
    <div class="alert alert-info">Azure SQL is not configured yet. Add Azure:SqlConnectionString before using this page.</div>
}
else if (Model == null || !Model.Any())
{
    <div class="alert alert-secondary">No processed records found yet.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr><th>Order ID</th><th>Amount</th><th>Status</th><th>Processed At</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderId</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.Status</td>
                <td>@item.ProcessedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        }
        </tbody>
    </table>
}
