<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealTime Agriculture</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">RealTime Agriculture</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Capture" asp-action="Index">Capture</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ProcessedData" asp-action="Index">Processed Data</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Logs" asp-action="Index">Logs / Commands</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("FarmerEmail") == null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Login" asp-action="Index">Farmer Login</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Login" asp-action="Logout">Logout</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container pb-5">@RenderBody()</main>

    <footer class="border-top py-3 text-muted">
        <div class="container">&copy; 2026 - RealTime Agriculture Practicum</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
