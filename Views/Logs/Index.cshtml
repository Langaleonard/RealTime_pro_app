@model OperationsViewModel
@{
    ViewData["Title"] = "Logs & Commands";
    var usingAzure = ViewBag.UsingAzure is bool b && b;
}

<h1>Logs & Irrigation Commands</h1>
<p class="text-muted">Operational evidence created while telemetry is processed. Storage mode: @(usingAzure ? "Azure Storage" : "Local demo fallback").</p>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h4>Irrigation Commands</h4>
                <p class="text-muted">Low soil moisture creates a message for the irrigation process.</p>
                @if (!Model.IrrigationCommands.Any())
                {
                    <div class="alert alert-info">No irrigation commands yet. Capture a moisture reading below 30%.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                    @foreach (var item in Model.IrrigationCommands)
                    {
                        <li class="list-group-item px-0">@item</li>
                    }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h4>Operational Logs</h4>
                <p class="text-muted">In Azure mode these are files stored in the <code>farm-logs</code> file share.</p>
                @if (!Model.OperationalLogs.Any())
                {
                    <div class="alert alert-info">No logs yet.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                    @foreach (var item in Model.OperationalLogs)
                    {
                        <li class="list-group-item px-0">@item</li>
                    }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
