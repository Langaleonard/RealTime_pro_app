@model IEnumerable<TelemetryRecord>
@{
    ViewData["Title"] = "Processed Data";
    var usingAzure = ViewBag.UsingAzure is bool b && b;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>Processed Data</h1>
        <p class="text-muted mb-1">Latest processed soil telemetry and drone observations.</p>
        <small class="text-muted">Storage mode: @(usingAzure ? "Azure Storage" : "Local demo fallback")</small>
    </div>
    <a asp-controller="Capture" asp-action="Index" class="btn btn-primary">Capture Reading</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No telemetry has been processed yet. Add a reading from the Capture tab.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Time</th><th>Sensor</th><th>Field</th><th>Moisture</th><th>Temp</th><th>Status</th><th>Note</th><th>Drone Image</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.ProcessedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@row.SensorId</td>
                    <td>@row.FieldName</td>
                    <td>@(row.SoilMoisture.ToString("0.##"))%</td>
                    <td>@(row.Temperature.ToString("0.##"))°C</td>
                    <td><strong>@row.Status</strong></td>
                    <td>@row.DroneNote</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(row.ImageName))
                        {
                            <img src="@Url.Action("Image", "ProcessedData", new { imageName = row.ImageName })" alt="Drone image" style="width:100px;height:70px;object-fit:cover;" />
                        }
                        else
                        {
                            <span class="text-muted">No image</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
