@model LoginViewModel
@{
    ViewData["Title"] = "Farmer Login";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5">
        <h1 class="mb-2">Farmer Login</h1>
        <p class="text-muted">Simple practicum login. Use any email and password for the demo.</p>
        <form asp-action="Index" method="post" class="card card-body shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="farmer@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">Login</button>
        </form>
    </div>
</div>
